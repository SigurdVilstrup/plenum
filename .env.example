# Copy to `.env` (gitignored). Loaded by `npm run dev` and Electron main.

# Feedback relay (Supabase Edge Function). Optional: the app defaults to the
# production relay (DEFAULT_FEEDBACK_URL in electron/feedback.mjs). Set this only
# to point at another relay. Anon key not required while Verify JWT is off.
# PLENUM_FEEDBACK_URL=https://nditdrfcnglhyxlimxwu.supabase.co/functions/v1/submit-feedback

# Optional — only if you turn Verify JWT on later:
# PLENUM_SUPABASE_ANON_KEY=
