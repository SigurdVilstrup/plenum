{
  "name": "plenum",
  "version": "0.4.8",
  "private": true,
  "description": "Git client for parallel work on Mac and Windows: board, lanes, git verbs, runnable lanes, CLI, and local MCP",
  "author": "Plenum",
  "main": "electron/main.mjs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/SigurdVilstrup/plenum.git"
  },
  "bin": {
    "plenum": "./bin/plenum.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prestart": "npm run build",
    "build": "node scripts/stamp-build-info.mjs && vite build",
    "start": "electron .",
    "test": "node --test --test-concurrency=1 electron/prefs.test.mjs electron/feedback.test.mjs electron/github-star.test.mjs electron/github-feedback.test.mjs electron/load-env.test.mjs electron/build-info.test.mjs electron/updates.test.mjs electron/os-open.test.mjs electron/git/*.test.mjs electron/lane/*.test.mjs electron/mcp/*.test.mjs electron/agents/*.test.mjs bin/*.test.mjs app/lib/*.test.mjs .agents/skills/plenum-release/scripts/*.test.mjs",
    "smoke:init": "node scripts/smoke-init.mjs",
    "icons": "node scripts/build-icons.mjs",
    "pack": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "pack:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "pack:win": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir",
    "dist": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "dist:win": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --publish never",
    "release:check": "node .agents/skills/plenum-release/scripts/release-check.mjs",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "plenum": "node ./bin/plenum.mjs"
  },
  "build": {
    "appId": "app.plenum.desktop",
    "productName": "Plenum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "bin/**/*",
      "man/**/*",
      "build/icon.icns",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.icns",
          "icon.ico",
          "icon.png"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://plenum.sh/updates/"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip",
        "dir"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "Plenum"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "dir"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Plenum-Setup-${version}.${ext}"
    },
    "forceCodeSigning": false
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
